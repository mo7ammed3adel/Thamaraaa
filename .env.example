# Copy to .env on the server and fill in. Never commit the real file.

# The bundled postgres container. "db" is its name on the compose network.
POSTGRES_USER="thamaraa"
POSTGRES_PASSWORD=""
POSTGRES_DB="thamaraa"
DATABASE_URL="postgresql://thamaraa:PASSWORD@db:5432/thamaraa?schema=public"

# Must match the URL users actually open, or NextAuth callbacks and the client
# portal cookie will not work.
NEXTAUTH_URL="https://crm.yourdomain.com"
# Must be identical to the Vercel value if both deployments should accept the
# same sessions; it also signs the client portal cookie.
NEXTAUTH_SECRET=""

# Host port the container publishes on. Pick one that is free on the server.
APP_PORT=3001

# Email (warning notifications only)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Protects the scheduled jobs (installment reminders, screenshot retention).
# Without it the cron endpoints refuse every request in production.
CRON_SECRET=""

# Where device screenshots are written. In Docker this is a mounted volume,
# deliberately outside the web root so images are never static assets.
SCREENSHOT_STORAGE_DIR="/data/screenshots"

# Where team-chat attachments are written. Also a mounted volume in Docker,
# outside the web root; files are only served to members of the conversation.
CHAT_STORAGE_DIR="/data/chat"

# Realtime (optional — the app falls back to polling when unset).
# Read at runtime, so changing them needs a restart, not a rebuild.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
# Self-hosted Soketi (the soketi service in docker-compose.yml). Leave these
# empty to use Pusher Cloud with the cluster above instead.
# Where the app server sends events (inside the docker network):
PUSHER_HOST="thamaraa-soketi"
PUSHER_PORT="6001"
# Where browsers connect (through Caddy, which strips /realtime):
PUSHER_PUBLIC_HOST="crm.thamaraa.com"
PUSHER_PUBLIC_PORT="443"
PUSHER_PUBLIC_PATH="/realtime"

# ── Calls: voice/video/screen share (self-hosted LiveKit, see docker-compose.yml)
# Leave empty to hide the call buttons. The secret must be 32+ characters.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# How the app reaches LiveKit (inside the docker network):
LIVEKIT_URL="http://thamaraa-livekit:7880"
# Where browsers connect for signaling (through Caddy, which strips /livekit):
LIVEKIT_PUBLIC_URL="wss://crm.thamaraa.com/livekit"
# This server's public IP — media flows to it on UDP 7882 / TCP 7881.
LIVEKIT_NODE_IP=""
# Turns the livekit service on in docker compose.
COMPOSE_PROFILES="calls"
