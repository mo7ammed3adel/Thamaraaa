# Copy to .env.production on the server and fill in. Never commit the real file.

# Same Neon database the Vercel deployment uses.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Must match the URL users actually open, or NextAuth callbacks and the client
# portal cookie will not work.
NEXTAUTH_URL="https://crm.yourdomain.com"
# Must be identical to the Vercel value if both deployments should accept the
# same sessions; it also signs the client portal cookie.
NEXTAUTH_SECRET=""

# Host port the container publishes on. Pick one that is free on the server.
APP_PORT=3001

# Email (warning notifications only)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Realtime (optional — the app falls back to polling when unset)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
