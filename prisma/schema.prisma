// ── NEW: Warning Receipt Model ──
// Replaces the JSON acknowledgedBy with a relational model for reliable enforcement
model WarningReceipt {
  id                String    @id @default(uuid())
  warningId         String
  warning           Warning   @relation(fields: [warningId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation("WarningReceiptUser", fields: [userId], references: [id])
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deliveredViaEmail Boolean   @default(false)
  emailSentAt       DateTime?
  createdAt         DateTime  @default(now())

  @@unique([warningId, userId])
  @@index([warningId])
  @@index([userId])
  @@index([userId, isRead])
}

// ── Client Portal Account ──
// Login for the CUSTOMER, deliberately kept out of the User table: clients are
// not employees, carry no role, and must never be reachable by any employee
// role check, HR record, payroll row or distribution dropdown. One account per
// Lead (customer); it grants read-only access to that customer's own projects.
model ClientAccount {
  id                  String    @id @default(uuid())
  username            String    @unique
  passwordHash        String
  leadId              String    @unique
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status              String    @default("Active") // Active, Suspended
  mustChangePassword  Boolean   @default(true)
  lastLoginAt         DateTime?
  // Brute-force protection. Counting on the account (not the IP) is the only
  // approach that holds on serverless, where every request may hit a fresh
  // instance with its own memory.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdByUserId     String
  createdAt           DateTime  @default(now())

  @@index([status])
}

// ── Device Monitoring ──
// A desktop agent installed on an employee's machine, enrolled once and
// identified thereafter by a hashed token. Monitoring is disclosed to the
// employee — the agent shows a visible tray icon and requires consent at
// install — so this is an attendance/oversight tool, not covert surveillance.
model MonitoredDevice {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String? // e.g. "Office PC", "Laptop" — set by the employee at enrolment
  hostname         String?
  platform         String? // win32, darwin, linux
  // Only the SHA-256 of the enrolment token is stored; the token itself lives
  // on the device and is never recoverable from the server.
  tokenHash        String    @unique
  status           String    @default("Active") // Active, Paused, Revoked
  lastSeenAt       DateTime?
  enrolledByUserId String
  createdAt        DateTime  @default(now())

  screenshots Screenshot[]
  Lead        Lead?        @relation(fields: [leadId], references: [id])
  leadId      String?

  @@index([userId])
  @@index([status])
}

model Screenshot {
  id         String          @id @default(uuid())
  deviceId   String
  device     MonitoredDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Path on disk, relative to the screenshots root — never an absolute path.
  storageKey String
  width      Int?
  height     Int?
  sizeBytes  Int?
  capturedAt DateTime // when the agent took it (device clock)
  createdAt  DateTime        @default(now()) // when the server received it
  Lead       Lead?           @relation(fields: [leadId], references: [id])
  leadId     String?

  @@index([userId, capturedAt])
  @@index([deviceId, capturedAt])
  @@index([capturedAt])
}
