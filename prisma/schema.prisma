generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String
  role               String // super_admin, hr_manager, accountant, tele_sales_manager, tele_sales_agent, sales_manager, sales_agent, chief_sales, head_account_manager, account_manager, head_technical, head_seo, team_leader_seo, agent_seo, agent_content_seo, team_leader_media_buyer, agent_media_buyer, team_leader_social_media, agent_social_media, leader_graphic_designer, agent_graphic_designer, leader_motion_graphic, agent_motion_graphic, leader_ui, agent_ui, team_leader, operations_agent
  level              String? // Junior, Mid, Senior
  directManagerId    String?
  directManager      User?     @relation("ManagerToSubordinates", fields: [directManagerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates       User[]    @relation("ManagerToSubordinates")
  company            String?
  companyId          String?
  companyRef         Company?  @relation("UserCompany", fields: [companyId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false)
  status             String    @default("Active") // Active, Inactive
  specialization     String? // Hot, Cold, Warm
  createdAt          DateTime  @default(now())
  lastStatusChange   DateTime?

  teleSalesLeads      Lead[]              @relation("TeleSalesAgent")
  salesLeads          Lead[]              @relation("SalesAgent")
  callLogs            CallLog[]
  salesDeals          Deal[]              @relation("DealSalesAgent")
  managedProjects     Project[]           @relation("ProjectAccountManager")
  headAmProjects      Project[]           @relation("ProjectHeadAccountManager")
  technicalProjects   Project[]           @relation("ProjectHeadTechnical")
  seoProjects         Project[]           @relation("ProjectHeadSeo")
  ledTasks            Task[]              @relation("TaskLeader")
  assignedTasks       Task[]              @relation("TaskAgent")
  hrRecord            HrRecord?
  attendances         Attendance[]
  commissions         Commission[]
  notifications       Notification[]
  leaveRequests       LeaveRequest[]
  documents           EmployeeDocument[]
  meetingsAsTele      Meeting[]           @relation("MeetingTeleAgent")
  meetingsAsSales     Meeting[]           @relation("MeetingSalesAgent")
  agentTargets        AgentTarget[]       @relation("AgentTargets")
  createdLeads        Lead[]              @relation("LeadCreator")
  sentWarnings        Warning[]           @relation("WarningSender")
  authoredNotes       Note[]              @relation("NoteAuthor")
  teamAssignments     TeamAssignment[]    @relation("TeamAssignmentUser")
  teamAssignmentsMade TeamAssignment[]    @relation("TeamAssignmentAssigner")
  warningReceipts     WarningReceipt[]    @relation("WarningReceiptUser")
  performanceReviews  PerformanceReview[] @relation("PerfReviewSubject")
  authoredReviews     PerformanceReview[] @relation("PerfReviewAuthor")
  onboardingTasks     OnboardingTask[]    @relation("OnboardingTaskUser")
  MonitoredDevice     MonitoredDevice[]
  Screenshot          Screenshot[]
}

model Niche {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]   @relation("UserCompany")
  leads     Lead[]   @relation("LeadCompany")
}

model Lead {
  id                   String    @id @default(uuid())
  name                 String
  phone                String
  nationality          String?
  gender               String?
  source               String?
  storeLink            String?
  hasStore             Boolean   @default(false)
  niche                String?
  classification       String // Hot, Warm, Cold
  customerType         String? // Store, Launch, Dropshipping, Shipping, Special
  status               String    @default("New") // New, Contacted, No_Answer, Interested, Transferred, In_Sales, Closed_Won, Closed_Lost, Archived
  assignedTeleAgentId  String?
  teleAgent            User?     @relation("TeleSalesAgent", fields: [assignedTeleAgentId], references: [id])
  assignedSalesAgentId String?
  salesAgent           User?     @relation("SalesAgent", fields: [assignedSalesAgentId], references: [id])
  createdById          String?
  createdBy            User?     @relation("LeadCreator", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  firstContactDate     DateTime?
  meetingDate          DateTime?
  meetingTime          String?
  meetingStartedAt     DateTime?
  meetingEndedAt       DateTime?
  followUpDate         DateTime?
  recycleCount         Int       @default(0)
  archivedAt           DateTime?
  salesNotes           String?
  companyId            String?
  company              Company?  @relation("LeadCompany", fields: [companyId], references: [id], onDelete: SetNull)

  callLogs           CallLog[]
  deals              Deal[]
  meetings           Meeting[]
  customColumnValues CustomColumnValue[]
  clientAccount      ClientAccount?
  monitoredDevices   MonitoredDevice[]
  screenshots        Screenshot[]

  @@index([companyId])
  @@index([assignedTeleAgentId])
  @@index([assignedSalesAgentId])
  @@index([status])
}

model AgentTarget {
  id        String   @id @default(uuid())
  agentId   String
  agent     User     @relation("AgentTargets", fields: [agentId], references: [id])
  month     String // YYYY-MM
  target    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([agentId, month])
}

model CallLog {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id])
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id])
  callStatus     String
  classification String?
  notes          String
  recordingUrl   String?
  meetingDate    DateTime?
  createdAt      DateTime  @default(now())

  @@index([leadId])
}

model Deal {
  id                    String    @id @default(uuid())
  leadId                String
  lead                  Lead      @relation(fields: [leadId], references: [id])
  salesAgentId          String
  salesAgent            User      @relation("DealSalesAgent", fields: [salesAgentId], references: [id])
  package               String // SEO, Social, Full
  contractStart         DateTime?
  contractEnd           DateTime?
  totalAmount           Float
  paymentMethod         String // Cash, Transfer, Tabby, Tamara, or "Split"
  paymentBreakdown      String? // JSON array of { method, amount } when the paid amount is split across methods
  netTarget             Float
  firstAmount           Float?
  installment1Date      DateTime?
  installment1Amount    Float?
  installment1Collected Boolean   @default(false)
  installment2Date      DateTime?
  installment2Amount    Float?
  installment2Collected Boolean   @default(false)
  installment3Date      DateTime?
  installment3Amount    Float?
  installment3Collected Boolean   @default(false)
  remainingPayments     Int       @default(0)
  contractImageUrl      String?
  receiptUrl            String?
  status                String    @default("Pending")
  createdAt             DateTime  @default(now())

  projects     Project[]
  installments Installment[]
}

model Meeting {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id])
  teleAgentId  String
  teleAgent    User     @relation("MeetingTeleAgent", fields: [teleAgentId], references: [id])
  salesAgentId String?
  salesAgent   User?    @relation("MeetingSalesAgent", fields: [salesAgentId], references: [id])
  meetingDate  DateTime
  meetingTime  String?
  status       String   @default("Scheduled") // Scheduled, Attended, Lost, Won
  salesNotes   String?
  summary      String?
  dealAmount   Float?
  createdAt    DateTime @default(now())

  @@index([leadId])
}

model CustomColumn {
  id        String              @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime            @default(now())
  values    CustomColumnValue[]
}

model CustomColumnValue {
  id       String       @id @default(uuid())
  columnId String
  column   CustomColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value    String       @default("")

  @@unique([columnId, leadId])
}

model Project {
  id                   String    @id @default(uuid())
  dealId               String
  deal                 Deal      @relation(fields: [dealId], references: [id])
  accountManagerId     String?
  accountManager       User?     @relation("ProjectAccountManager", fields: [accountManagerId], references: [id])
  headAccountManagerId String?
  headAccountManager   User?     @relation("ProjectHeadAccountManager", fields: [headAccountManagerId], references: [id])
  headTechnicalId      String?
  headTechnical        User?     @relation("ProjectHeadTechnical", fields: [headTechnicalId], references: [id])
  headSeoId            String?
  headSeo              User?     @relation("ProjectHeadSeo", fields: [headSeoId], references: [id])
  niche                String?
  package              String
  packageId            String?
  technicalDeadline    DateTime?
  addedDurationDays    Int       @default(0)
  finalDeadline        DateTime?
  seoProgress          Int       @default(0)
  socialMediaProgress  Int       @default(0)
  mediaBuyerProgress   Int       @default(0)
  storeCreated         Boolean   @default(false)
  userCreatedStore     Boolean   @default(false)
  storeUrl             String?
  driveLink            String?
  screenshotUrl        String?
  priority             String?

  finalStatus    String    @default("Active") // Active, Lost, Done — DEPRECATED: use lifecycleState
  projectStatus  String    @default("new") // new, setup, assigned, in_progress, completed, on_hold, delayed, cancelled
  lifecycleState String    @default("Active") // Active, Hold, Renewer, Lost
  assignedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  tasks           Task[]
  files           ProjectFile[]
  logs            ProjectLog[]
  globalNotes     Note[]
  teamAssignments TeamAssignment[]
  warnings        Warning[]        @relation("ProjectWarnings")

  @@index([lifecycleState])
  @@index([accountManagerId])
  @@index([headAccountManagerId])
}

model Task {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  leaderId        String
  leader          User      @relation("TaskLeader", fields: [leaderId], references: [id])
  agentId         String?
  agent           User?     @relation("TaskAgent", fields: [agentId], references: [id])
  taskType        String
  checklistItems  String // JSON string
  progressPct     Float     @default(0)
  requesterRole   String? // Role that created/requested this task
  assignedRole    String? // Target role for the task
  brief           String? // Creative brief or task description
  taskLink        String? // Reference link attached by requesting agent
  deadline        DateTime? // Task-level deadline
  priority        String    @default("Medium") // High, Medium, Low
  status          String    @default("pending") // pending, in_progress, review, done
  parentTaskId    String? // For sub-tasks (e.g. Social → Graphic Design)
  parentTask      Task?     @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks        Task[]    @relation("SubTasks")
  files           String? // JSON string for deliverable URLs
  startedAt       DateTime? // When the agent actually started working
  flagReason      String? // Reason text when agent flags/returns task to Team Leader
  flaggedAt       DateTime? // Timestamp of flag action
  flaggedByUserId String? // User ID of agent who flagged the task
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model HrRecord {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  baseSalary         Float
  level              String
  monthlyTarget      Float
  performanceHistory String // JSON string for SQLite
  promotionEligible  Boolean   @default(false)
  warningCount       Int       @default(0)
  terminationFlag    Boolean   @default(false)
  employeeCode       String?   @unique
  personalEmail      String?
  nationalId         String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  department         String?
  jobTitle           String?
  hiringDate         DateTime?
  employmentType     String?
  workMode           String?   @default("onsite") // onsite | remote
  employmentStatus   String    @default("active")
  resignationDate    DateTime?
  startingSalary     Float?
  currentSalary      Float?
  documentChecklist  String    @default("{}")
  fingerprintCode    String?
  allowances         Float     @default(0)
  workingHoursPerDay Float     @default(8)
  bankAccount        String?
}

model Attendance {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  lateMinutes       Int       @default(0)
  deductionDraft    Float?
  deductionApproved Boolean   @default(false)
  earlyLeaveMinutes Int       @default(0)
  status            String    @default("on_time")
  exemptionType     String?
  exemptionRef      String?
  payrollPeriod     String?
  deductionHours    Float     @default(0)
  importedBatchId   String?
}

model Commission {
  id               String  @id @default(uuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id])
  month            String // YYYY-MM
  netTarget        Float
  commissionPct    Float
  commissionAmount Float
  bonuses          String // JSON string for SQLite
  deductions       String // JSON string for SQLite
  netPayout        Float
  finalized        Boolean @default(false)
}

model SystemConfig {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String? // lead_assigned, meeting_update, deal_closed, etc.
  read      Boolean  @default(false)
  link      String?
  relatedId String? // Generic reference to related entity (task, project, etc.)
  createdAt DateTime @default(now())

  @@index([userId])
}

model JobApplicant {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  roleApplied String
  status      String   @default("New") // New, HR_Interview, Department_Interview, Offer, Rejected, Hired
  resumeUrl   String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Installment {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  amount    Float
  dueDate   DateTime
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          String // Remote, Leave, Permission
  date          DateTime
  duration      String? // e.g. "1 Day", "2 Hours"
  status        String    @default("Pending") // Pending, Approved, Rejected
  reason        String?
  feedbackNotes String?
  startDate     DateTime?
  endDate       DateTime?
  days          Float?
  attachmentUrl String?
  approverId    String?
  approverNotes String?
  createdAt     DateTime  @default(now())
}

model EmployeeDocument {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String // e.g. "CV", "Contract", "ID"
  fileUrl   String
  createdAt DateTime @default(now())
}

model CommissionRule {
  id         String   @id @default(uuid())
  role       String   @unique // e.g., "sales_agent", "team_leader_seo"
  percentage Float
  updatedAt  DateTime @updatedAt
}

model PerformanceReview {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("PerfReviewSubject", fields: [userId], references: [id])
  reviewerId   String
  reviewer     User     @relation("PerfReviewAuthor", fields: [reviewerId], references: [id])
  period       String // e.g. "2026-06" or "2026-Q2"
  rating       Int // 1-5
  strengths    String?
  improvements String?
  goals        String?
  createdAt    DateTime @default(now())
}

model OnboardingTask {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("OnboardingTaskUser", fields: [userId], references: [id])
  kind        String    @default("onboarding") // onboarding | offboarding
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
}

model HrDepartment {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String?
  status        String               @default("active") // active | inactive
  headId        String?
  teamLeaderIds String               @default("[]") // JSON array of user ids
  policy        String               @default("{}") // JSON: evaluation / salary / commission / probation config
  parentId      String?
  parent        HrDepartment?        @relation("HrDepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      HrDepartment[]       @relation("HrDepartmentTree")
  documents     DepartmentDocument[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model DepartmentDocument {
  id           String       @id @default(uuid())
  departmentId String
  department   HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String
  createdAt    DateTime     @default(now())

  @@index([departmentId])
}

model SalaryHistory {
  id             String    @id @default(uuid())
  userId         String
  effectiveDate  DateTime
  previousSalary Float
  newSalary      Float
  increaseAmount Float
  increasePct    Float
  changeType     String
  nextReviewDate DateTime?
  reviewStatus   String    @default("pending")
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model HrPayrollPeriod {
  id                      String           @id @default(uuid())
  month                   String           @unique
  status                  String           @default("Draft")
  generatedById           String?
  generatedAt             DateTime?
  approvedById            String?
  approvedAt              DateTime?
  publishedById           String?
  publishedAt             DateTime?
  lockedById              String?
  lockedAt                DateTime?
  reopenedById            String?
  reopenedAt              DateTime?
  reopenedReason          String?
  bonusSubmissionDeadline DateTime?
  notes                   String?
  entries                 HrPayrollEntry[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model HrPayrollEntry {
  id                      String          @id @default(uuid())
  periodId                String
  period                  HrPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId                  String
  employeeCode            String?
  employeeName            String
  department              String?
  position                String?
  fingerprintCode         String?
  baseSalary              Float           @default(0)
  allowances              Float           @default(0)
  hourlyRate              Float           @default(0)
  workingHoursPerDay      Float           @default(8)
  workingDays             Int             @default(26)
  daysPresent             Float           @default(0)
  daysAbsent              Float           @default(0)
  unexcusedAbsenceDays    Float           @default(0)
  lateArrivals            Int             @default(0)
  earlyLeaves             Int             @default(0)
  approvedLeaveDays       Float           @default(0)
  approvedRemoteDays      Float           @default(0)
  approvedPermissionHours Float           @default(0)
  totalDeductionHours     Float           @default(0)
  attendanceDeduction     Float           @default(0)
  absenceDeduction        Float           @default(0)
  warningDeduction        Float           @default(0)
  advanceDeduction        Float           @default(0)
  manualDeduction         Float           @default(0)
  manualDeductionNote     String?
  bonus                   Float           @default(0)
  commission              Float           @default(0)
  achievementPct          Float           @default(0)
  performanceNotes        String?
  manualBonus             Float           @default(0)
  manualBonusNote         String?
  manuallyModified        Boolean         @default(false)
  attendanceException     Boolean         @default(false)
  warningRecommended      Boolean         @default(false)
  bonusSubmittedById      String?
  bonusSubmittedAt        DateTime?
  netSalary               Float           @default(0)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([periodId, userId])
  @@index([userId])
}

model SalaryAdvance {
  id                      String    @id @default(uuid())
  userId                  String
  amount                  Float
  reason                  String
  status                  String    @default("pending_dept_head")
  deptHeadApprovedById    String?
  deptHeadApprovedAt      DateTime?
  accountantApprovedById  String?
  accountantApprovedAt    DateTime?
  paidAt                  DateTime?
  deductedPayrollPeriodId String?
  rejectionReason         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model RecruitmentRequest {
  id                String    @id @default(uuid())
  departmentId      String?
  departmentName    String?
  positionTitle     String
  level             String
  minExperience     String?
  requiredStartDate DateTime?
  vacancies         Int       @default(1)
  notes             String?
  status            String    @default("pending")
  assignedHrId      String?
  requestedById     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}

model KpiTemplate {
  id             String    @id @default(uuid())
  name           String
  departmentId   String?
  departmentName String?
  targetRole     String
  active         Boolean   @default(true)
  // Versioning: editing a template's structure creates a NEW version row and
  // marks the previous one isLatest=false, so completed evaluations stay linked
  // to the exact KPI structure/weights they were scored against (immutable history).
  version        Int       @default(1)
  isLatest       Boolean   @default(true)
  rootId         String? // groups all versions of one logical template; null = this row is the root
  items          KpiItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([rootId])
  @@index([isLatest])
}

model KpiItem {
  id          String      @id @default(uuid())
  templateId  String
  template    KpiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  weight      Float
  description String?
  createdAt   DateTime    @default(now())
}

model EmployeeExit {
  id                 String    @id @default(uuid())
  userId             String
  exitType           String
  submissionDate     DateTime
  notificationDate   DateTime?
  lastWorkingDay     DateTime?
  requiredNoticeDays Int       @default(0)
  noticeStatus       String    @default("pending")
  clearanceStatus    String    @default("pending")
  finalSalaryStatus  String    @default("pending")
  assetChecklist     String    @default("{}")
  exitInterviewNotes String?
  hrOverride         Boolean   @default(false)
  hrOverrideReason   String?
  archiveStatus      String    @default("open")
  archivedById       String?
  archivedAt         DateTime?
  initiatedById      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model HrComplaint {
  id            String            @id @default(uuid())
  userId        String
  subject       String
  details       String
  attachmentUrl String?
  visibility    String            @default("hr_only")
  status        String            @default("open")
  assignedHrId  String?
  notes         HrComplaintNote[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model HrComplaintNote {
  id          String      @id @default(uuid())
  complaintId String
  complaint   HrComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  note        String
  createdAt   DateTime    @default(now())
}

model HrWarning {
  id               String   @id @default(uuid())
  userId           String
  type             String
  date             DateTime
  description      String
  issuedById       String
  attachmentUrl    String?
  payrollDeduction Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model HrContract {
  id        String    @id @default(uuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  fileUrl   String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmployeeFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model EmployeeAsset {
  id        String   @id @default(uuid())
  userId    String
  assetType String
  returned  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model HrSystemSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

// Internal HR-only asset tool: stores ONLY the latest device/computer password
// per employee (no history). Visible/editable to HR Admin only.
model DevicePassword {
  id          String   @id @default(uuid())
  userId      String   @unique
  password    String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HrActivityLog {
  id            String   @id @default(uuid())
  module        String
  action        String
  actorId       String?
  employeeId    String?
  entityType    String?
  entityId      String?
  previousValue String?
  newValue      String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([actorId])
  @@index([employeeId])
